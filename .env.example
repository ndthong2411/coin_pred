# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=True  # Set to False for live trading

# Trading Configuration
TRADING_MODE=paper  # paper or live
MAX_POSITION_SIZE=0.05  # 5% of portfolio per trade
MAX_DAILY_LOSS=0.05  # 5% max daily loss
STOP_LOSS_PERCENT=0.005  # 0.5% stop loss
TAKE_PROFIT_PERCENT=0.01  # 1% take profit
MIN_CONFIDENCE_SCORE=0.70  # Minimum prediction confidence

# Target Coins (comma-separated)
TARGET_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_trading
# For SQLite (simpler): sqlite:///data/trading.db

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ENABLE_TELEGRAM_ALERTS=True

# Twitter API (for sentiment)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Reddit API (for sentiment)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=CryptoTradingBot/1.0

# External Market Data APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FINNHUB_API_KEY=your_finnhub_key

# Model Configuration
MODEL_RETRAIN_DAYS=7  # Retrain models every N days
FEATURE_WINDOW_SIZE=60  # Number of candles for features
PREDICTION_HORIZON=15  # Predict N minutes ahead

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# System
TIMEZONE=UTC
DATA_UPDATE_INTERVAL=60  # seconds
HEARTBEAT_INTERVAL=300  # seconds (5 minutes)
